# Build output. Everything here is reproducible from source with build.ps1,
# and the zips are rewritten on every run — tracking them would mean a diff on
# each build with nothing to review.
dist/
*.zip
*.xpi

# Machine-local tool permissions, not project configuration.
.claude/settings.local.json

# Google Drive sync scaffolding. Not project files.
.Trash-1000/
.tmp.driveupload/

# Generated by tests/build.py - embeds a full copy of content.js, so it would
# churn on every edit and duplicate the source in history.
tests/runner.html

# Generated by tests/build.py - renders the real popup against stubbed
# extension APIs, so tracking it would duplicate popup.js in history.
tests/popup-smoke.html
